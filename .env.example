# ─────────────────────────────────────────────────────────
# HIFAZAT AI — Environment Variables
# Copy this file to .env and fill in your values.
# On Render, set these directly in the dashboard or render.yaml.
# ─────────────────────────────────────────────────────────

# ── Deployment ───────────────────────────────────────────
# Set to true on Render/cloud — disables localhost-only restriction
PUBLIC_DEPLOYMENT=false

# ── CORS ─────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# On Render set to: https://hifazat-ai.onrender.com

# ── Database ─────────────────────────────────────────────
# SQLite (default) — resets on Render free tier restart
DATABASE_URL=sqlite:///./bullylens.db

# ── YouTube API (optional) ────────────────────────────────
YOUTUBE_API_KEY=
FORCE_DEMO_MODE=false

# ── GenAI / Explanations (optional) ──────────────────────
ALLOW_EXTERNAL_EXPLANATIONS=false
GENAI_API_KEY=
GENAI_BASE_URL=https://api.openai.com/v1
GENAI_MODEL=gpt-4o-mini
