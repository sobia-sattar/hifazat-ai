# Copy to .env and fill in values. Never commit secrets.

# Official YouTube Data API v3 key (optional — demo mode is used when missing)
YOUTUBE_API_KEY=
# Optional owner-authorized OAuth token; never returned to the browser.
# Scope: https://www.googleapis.com/auth/youtube.force-ssl
YOUTUBE_OAUTH_ACCESS_TOKEN=
YOUTUBE_OWNER_CHANNEL_ID=

# Optional OpenAI-compatible GenAI endpoint. Application works without this.
GENAI_API_KEY=
GENAI_BASE_URL=https://api.openai.com/v1
GENAI_MODEL=gpt-4o-mini

# App
APP_NAME=BullyLens-X
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=sqlite:///./bullylens.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Confidence thresholds (research safety)
HIGH_CONFIDENCE_THRESHOLD=0.75
LOW_CONFIDENCE_THRESHOLD=0.55

# Demo
FORCE_DEMO_MODE=false

# Privacy opt-in: allows comment excerpts to leave this workstation for GenAI explanations.
# Requires GENAI_API_KEY; leave false for local-only inference.
ALLOW_EXTERNAL_EXPLANATIONS=false
